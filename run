#!/usr/bin/env bash
# Запуск frontend и backend из VS Code (один терминал, Ctrl+C останавливает оба).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_PID=""
FRONTEND_PID=""

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Нужна команда: $1"
    exit 1
  fi
}

port_busy() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

hash_file() {
  shasum -a 256 "$1" | awk '{print $1}'image.png
}

cleanup() {
  local pid
  for pid in "$BACKEND_PID" "$FRONTEND_PID"; do
    if [[ -n "${pid}" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
    fi
  done
}

trap cleanup EXIT INT TERM

require_cmd node
require_cmd npm
require_cmd python3
require_cmd lsof

if [[ ! -d "$ROOT/.venv" ]]; then
  echo "Создаю venv..."
  (cd "$ROOT" && python3 -m venv .venv)
fi

req="$ROOT/backend/requirements.txt"
stamp="$ROOT/.venv/.webdelta_backend_reqs.sha256"
current_hash="$(hash_file "$req")"
if [[ ! -f "$stamp" ]] || [[ "$(cat "$stamp")" != "$current_hash" ]]; then
  echo "Устанавливаю Python-зависимости..."
  # shellcheck disable=SC1091
  source "$ROOT/.venv/bin/activate"
  python -m pip install -U pip
  pip install -r "$req"
  echo "$current_hash" >"$stamp"
fi

pw_stamp="$ROOT/.venv/.webdelta_playwright.ok"
if [[ ! -f "$pw_stamp" ]] || [[ ! -d "$ROOT/.playwright-browsers" ]]; then
  echo "Устанавливаю Chromium для Playwright..."
  # shellcheck disable=SC1091
  source "$ROOT/.venv/bin/activate"
  export PLAYWRIGHT_BROWSERS_PATH="$ROOT/.playwright-browsers"
  python -m playwright install chromium
  touch "$pw_stamp"
fi

if [[ ! -d "$ROOT/frontend/node_modules" ]]; then
  echo "Устанавливаю frontend-зависимости..."
  (cd "$ROOT/frontend" && npm install)
fi

echo "Backend: http://127.0.0.1:8000"
echo "Frontend: http://localhost:3000"
echo "Ctrl+C останавливает оба процесса."

if port_busy 8000; then
  echo "Порт 8000 уже занят — backend не запускаю."
else
  (
    cd "$ROOT/backend"
    export PLAYWRIGHT_BROWSERS_PATH="$ROOT/.playwright-browsers"
    exec "$ROOT/.venv/bin/python" -m uvicorn app.main:app --host 127.0.0.1 --port 8000
  ) &
  BACKEND_PID=$!
fi

if port_busy 3000; then
  echo "Порт 3000 уже занят — frontend не запускаю."
else
  (
    cd "$ROOT/frontend"
    export NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL:-http://127.0.0.1:8000}"
    exec npm run dev
  ) &
  FRONTEND_PID=$!
fi

if [[ -z "$BACKEND_PID" && -z "$FRONTEND_PID" ]]; then
  echo "Нечего запускать: порты 8000 и 3000 уже заняты."
  exit 1
fi

wait
