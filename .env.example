# Backend
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Local snapshots (always written)
RESULTS_DIR=results

# Supabase (optional). If empty, the app reads/writes only results/
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ATTACHMENTS_BUCKET=attachments

# OpenAI (optional: enables explanation after compare)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Post analyzer (delta explainer) provider switch:
# - openai: uses OPENAI_API_KEY + OPENAI_MODEL
# - lmstudio: uses LM Studio OpenAI-compatible server
ANALYZER_PROVIDER=openai
POST_ANALYZER_LLM_MODEL=deepseek-coder-v2-lite-instruct
POST_ANALYZER_OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# File meaning compare (optional). LM Studio by default; change the URL and key for a paid model.
FILEDIFF_BASE_URL=http://127.0.0.1:1234/v1
FILEDIFF_MODEL=
FILEDIFF_API_KEY=lm-studio
FILEDIFF_USAGE_PATH=results/filediff-usage.jsonl

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHANNEL=chrome-beta

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

