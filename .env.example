# Backend
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Storage backend: "supabase" (recommended) or "sqlite" (dev fallback)
STORAGE_BACKEND=supabase
SQLITE_PATH=backend/webdelta.dev.db
RESULTS_DIR=results

# Supabase (required when STORAGE_BACKEND=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ATTACHMENTS_BUCKET=attachments

# OpenAI (optional: enables explanation after compare)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Post analyzer (delta explainer) provider switch:
# - openai: uses OPENAI_API_KEY + OPENAI_MODEL
# - lmstudio: uses LM Studio OpenAI-compatible server
ANALYZER_PROVIDER=openai
POST_ANALYZER_LLM_MODEL=deepseek-coder-v2-lite-instruct
POST_ANALYZER_OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHANNEL=chrome-beta

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

