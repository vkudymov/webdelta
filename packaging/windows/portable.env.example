# Portable Windows. UI and API share 127.0.0.1 (see PORT). Do not set PLAYWRIGHT_CHANNEL:
# an empty value uses the Chromium shipped in .playwright-browsers/.

HOST=127.0.0.1
PORT=8765
CORS_ORIGINS=http://127.0.0.1:8765

RESULTS_DIR=results

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ATTACHMENTS_BUCKET=attachments

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

ANALYZER_PROVIDER=openai
POST_ANALYZER_LLM_MODEL=deepseek-coder-v2-lite-instruct
POST_ANALYZER_OPENAI_BASE_URL=http://127.0.0.1:1234/v1

FILEDIFF_BASE_URL=http://127.0.0.1:1234/v1
FILEDIFF_MODEL=
FILEDIFF_API_KEY=lm-studio
FILEDIFF_USAGE_PATH=results/filediff-usage.jsonl

PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHANNEL=
